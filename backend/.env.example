# Environment and public URLs
APP_ENV=development
APP_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081

# Database and tenant context (store real values as hosting secrets)
MONGO_URL=mongodb://localhost:27017
DB_NAME=ordo_development
TENANCY_MODE=single
DEFAULT_TENANT_ID=tnt_ss_0001
JWT_SECRET=replace-with-a-long-random-secret

# Payments
STRIPE_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Provider-neutral object storage: s3 for staging/production, local only for development/tests
STORAGE_BACKEND=local
STORAGE_LOCAL_DIRECTORY=./var/uploads
S3_ENDPOINT_URL=https://s3.example.invalid
S3_BUCKET=replace-me
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_ADDRESSING_STYLE=auto

# Provider-neutral email transport
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM_EMAIL=no-reply@example.invalid
EMAIL_FROM_NAME=ORDO Connect
EMAIL_REPLY_TO=support@example.invalid
EMAIL_MESSAGE_ID_DOMAIN=example.invalid

# Push transport
PUSH_BACKEND=expo
EXPO_ACCESS_TOKEN=

# Run python -m scripts.run_worker as a separate service when enabled
BACKGROUND_JOBS_ENABLED=false
WORKER_ID=

# Optional operational backup tooling
BACKUP_DIRECTORY=./var/backups
