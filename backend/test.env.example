# Copy to backend/.env.test for the opt-in live integration suite only.
# The target database must be an isolated, disposable copy. Never use staging or production.
APP_ENV=test
EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=ordo_test_integration
ORDO_RUN_LIVE_INTEGRATION=1
ORDO_TEST_TARGET_CONFIRMATION=test:ordo_test_integration

# Supply temporary credentials outside Git. Do not commit real values.
ORDO_TEST_ADMIN_EMAIL=admin@example.test
ORDO_TEST_ADMIN_PASSWORD=replace-me
ORDO_TEST_SALES_EMAIL=sales@example.test
ORDO_TEST_SALES_PASSWORD=replace-me
ORDO_TEST_CUSTOMER_EMAIL=customer@example.test
ORDO_TEST_CUSTOMER_PASSWORD=replace-me
